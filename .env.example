# Local development. Copy to .env and fill in. Never commit .env.
APP_ENV=dev
BASE_URL=http://localhost:8080
STORE=memory                       # or "firestore" with GCP_PROJECT set (uses your gcloud ADC)
# GCP_PROJECT=your-project-id

SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=

# OAuth client of type "Web application" with redirect URI http://localhost:8080/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test mode keys. Webhook secret comes from `stripe listen` output.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Leave empty in dev: Gmail push needs a public URL, so use "Run cleanup" to test filtering.
PUBSUB_TOPIC=

# Optional: SMTP for weekly digests (unset = emails are logged, not sent)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Unmangle <digest@example.com>
SUPPORT_EMAIL=support@example.com
